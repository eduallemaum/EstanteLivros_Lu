rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permit client-side read/write to family books for synchronization
    match /books/{document} {
      allow read, write: if true;
    }
    
    // Explicitly lock down sensitive credentials and security audit logs from client-side SDK access
    match /family_users/{document} {
      allow read, write: if false;
    }
    
    match /access_logs/{document} {
      allow read, write: if false;
    }
    
    // Default fallback rule is secure denial
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
